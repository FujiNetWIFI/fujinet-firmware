;
; FujiNet Project
;
; Vintage Macintosh Microfloppy Controller Interface
; outputs IWM pulse train to Mac
;
;

; Each bit is a pulse carrying its value, then a blank: at clkdiv 13 (0.104 us
; a tick) 5 + 14 ticks, 0.52 us in 1.98 us. The logic analyzer showed 0.4 us
; pulses in 2.1 us periods; a floppy emulator works with 0.5 us in 2.0 us.

.program dcd_write
.wrap_target
    out pins, 1             [4]
    set pins, 0             [13]
.wrap  

% c-sdk {

void dcd_write_program_init(PIO pio, uint sm, uint offset, uint pin) {
   pio_sm_config c = dcd_write_program_get_default_config(offset);
   sm_config_set_set_pins(&c, pin, 1);
   sm_config_set_out_pins(&c, pin, 1); 
   sm_config_set_out_shift(&c, false, true, 8);
   sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
   
    sm_config_set_clkdiv(&c, 13); // 13, not 12.5: an integer divide
   pio_sm_init(pio, sm, offset, &c);
}
%}