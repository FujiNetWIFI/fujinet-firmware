; CONFIG.COM's Boot under CP/M when the page uses PHANTOM*: the page is gone
; once CP/M runs, so CONFIG says so and warm boots instead.
; mount 0 mits-cpm22-burcon-56k.dsk rw
; timeout 180
; must warm booting instead
set fujinet phantom
reset fujinet
expect "A>" load %CONFIGCOM% 100; send "SAVE %PAGES:%CONFIGCOM%% CONFIG.COM\r"; continue
expect "A>" send "CONFIG\r"; continue
expect "[Q]uit" send after=100000,"C"; continue
expect "00h (PHANTOM)" send after=100000,"x"; continue
expect "[Q]uit" send after=100000,"\033"; continue
expect "warm booting instead" expect "A>" echo "*** PASS ***"; continue
go ff00
