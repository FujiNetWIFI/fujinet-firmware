; fujiboot.a48 -- mount a cartridge image over the network and boot it.
;
; MOUNT_HOST -> SET_DEVICE_FULLPATH -> MOUNT_IMAGE. The last one makes the
; ESP32 side stream the image back to the cartridge on the same link, as
; unsolicited frames addressed to the DBC device, while MOUNT_IMAGE's own reply
; is still outstanding.
;
; The cartridge cannot reset the Odyssey 2 -- there is no reset line on the
; connector -- so a booted image takes over on the next $400 fetch, i.e. when
; the player presses RESET.

    cpu 8048
    org 400h
    include "g7000.h"
    include "vdctext.inc"
    include "o2fuji.inc"

    include "bootcfg.inc"       ; HOSTSLOT, generated by build.sh
DEVSLOT  equ 0
XP       equ 24

    jmp start                   ; $400 reset
    jmp irqret                  ; $402 external IRQ
    jmp irqret                  ; $404 timer IRQ
    jmp irqret                  ; $406 vblank
    jmp start                   ; $408 after BIOS "select game"
    jmp irqret                  ; $40A vblank continuation
irqret:
    retr

start:
    dis i
    dis tcnti
    call vdc_init

    mov a,#FN_R_MAGIC0&0FFh
    call fn_read
    xrl a,#'F'
    jnz bad_nc

; ---- MOUNT_HOST(host) ----
    mov a,#P1_SEL_XRAM
    outl p1,a
    mov r2,#1                   ; nparam
    mov r3,#0                   ; txlen hi
    mov a,#FUJICMD_MOUNT_HOST
    call fn_begin
    mov a,#HOSTSLOT
    call fn_par1
    call fn_fire
    xrl a,#FUJICMD_ACK
    jnz bad_host

; ---- SET_DEVICE_FULLPATH(dev, host, mode, path) ----
; The payload must be the full 256 bytes NUL-padded: the firmware reads it with
; transaction_get() into a fixed buffer and fails a short read.
    mov r2,#3
    mov r3,#1                   ; txlen = $0100 = 256
    mov a,#FUJICMD_SET_DEVICE_FULLPATH
    call fn_begin
    mov a,#DEVSLOT
    call fn_par1
    mov a,#HOSTSLOT
    call fn_par1
    mov a,#MODE_READ
    call fn_par1
    call push_path
    call fn_fire
    xrl a,#FUJICMD_ACK
    jnz bad_path

; ---- MOUNT_IMAGE(dev, mode) ----
    mov r2,#2
    mov r3,#0
    mov a,#FUJICMD_MOUNT_IMAGE
    call fn_begin
    mov a,#DEVSLOT
    call fn_par1
    mov a,#MODE_READ
    call fn_par1
    call fn_fire
    xrl a,#FUJICMD_ACK
    jnz bad_mount

    mov a,#msg_ok&0FFh
    jmp report

bad_nc:
    mov a,#msg_nc&0FFh
    jmp report
bad_host:
    mov a,#msg_host&0FFh
    jmp report
bad_path:
    mov a,#msg_path&0FFh
    jmp report
bad_mount:
    mov a,#msg_mount&0FFh
    jmp report

report:
    mov r4,a
    mov a,#P1_SEL_VDC
    outl p1,a
    mov r0,#vdc_char0
    mov r3,#XP
    mov a,r4
    call puts_e
    mov r0,#vdc_control
    mov a,#vdc_ctrl_fore
    movx @r0,a
spin:
    jmp spin

; push_path: send the boot path as exactly 256 bytes, NUL-padded.
; Reading past the terminator would wrap around page $E00 into the character
; map, so the copy switches to emitting zeroes once it sees the NUL rather
; than reading 256 bytes blind. P1 = P1_SEL_XRAM.
    org 4A0h
push_path:
    mov r1,#bootpath&0FFh
    mov r2,#0                   ; 256 iterations
    mov r4,#1                   ; 1 = still copying, 0 = padding
ppl:
    mov a,r4
    jz ppzero
    sel mb1
    mov a,r1
    call str_get
    sel mb0
    jnz ppput
    mov r4,#0
ppzero:
    clr a
ppput:
    call fn_push
    inc r1
    djnz r2,ppl
    ret

    include "fujilib.inc"

    org 0D02h
msg_ok:    db "PRESS RESET",0
msg_nc:    db "NO CART",0
msg_host:  db "HOST FAIL",0
msg_path:  db "PATH FAIL",0
msg_mount: db "MOUNT FAIL",0

    include "bootpath.inc"      ; bootpath, generated by build.sh

    include "fujistub.inc"
