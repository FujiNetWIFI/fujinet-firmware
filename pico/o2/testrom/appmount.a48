; appmount.a48 -- protocol 2 (APPBANK) client that mounts a cartridge image and
; shows the cartridge's progress while it is pushed, then resets into it.
;
; This is the shape a CONFIG has: MOUNT_HOST -> SET_DEVICE_FULLPATH ->
; MOUNT_IMAGE, with the MOUNT_IMAGE committed by hand. The firmware pushes the
; whole image before it ACKs, so a client that waits for the ACK sees nothing.
; This one writes SEQ and does not wait: it polls ACKSEQ and, between polls,
; draws the boot state and percent from the status page ($F26, $F27).
;
;     S   H T U       S = FN_R_BOOT_STATE (0 idle, 1 xfer, 2 ready, 8 failed)
;                     H T U = FN_R_BOOT_PCT, 000-100
;
; On the ACK it checks the reply and READY, holds the final screen a moment and
; jumps to $000: the console's soft reset. The BIOS runs again and fetches $400,
; which is when the cartridge swaps in the pushed image.
;
; Boot target: BOOT_HOST / BOOT_PATH, as build.sh passes them for fujiboot.

    cpu 8048
    org 400h
    include "g7000.h"
    include "vdctext.inc"
    include "o2fuji.inc"

    include "bootcfg.inc"       ; HOSTSLOT, generated by build.sh
DEVSLOT  equ 0
XPOS     equ 24
NPAGES   equ 4                  ; build.sh builds every app* with four pages
V_SEQ    equ 024h               ; the sequence number MOUNT_IMAGE was sent with
V_LAST   equ 026h               ; the state and percent last drawn (2 bytes)
FN_BOOT_READY equ 2

    jmp start                   ; $400 reset
    jmp irqret                  ; $402 external IRQ
    jmp irqret                  ; $404 timer IRQ
    jmp irqret                  ; $406 vblank
    jmp start                   ; $408 after BIOS "select game"
    jmp irqret                  ; $40A vblank continuation
irqret:
    retr

; push_path: send the boot path as exactly 256 bytes, NUL-padded (the ESP32
; fails a short read). Zeroes follow the NUL rather than 256 blind reads, which
; would wrap around page $D00. P1 = P1_SEL_XRAM.
    org 4A0h
push_path:
    mov r1,#bootpath&0FFh
    mov r2,#0                   ; 256 iterations
    mov r4,#1                   ; 1 = still copying, 0 = padding
ppl:
    mov a,r4
    jz ppzero
    sel mb1
    mov a,r1
    call str_get
    sel mb0
    jnz ppput
    mov r4,#0
ppzero:
    clr a
ppput:
    call fn_push
    inc r1
    djnz r2,ppl
    ret

    include "fujilib.inc"       ; self-pinned to $4D0, ends at $63A

; ---------------------------------------------------------------- main
    org 640h
start:
    dis i
    dis tcnti
    call vdc_init

    mov a,#FN_R_MAGIC0&0FFh
    call fn_read
    xrl a,#'F'
    jz is_cart
    jmp bad_nc
is_cart:
    mov r0,#V_LAST              ; nothing drawn yet: no value matches this
    mov a,#0FFh
    mov @r0,a
    inc r0
    mov @r0,a

; ---- MOUNT_HOST(host) ----
    mov a,#P1_SEL_XRAM
    outl p1,a
    mov r2,#1                   ; nparam
    mov r3,#0                   ; txlen hi
    mov a,#FUJICMD_MOUNT_HOST
    call fn_begin
    mov a,#HOSTSLOT
    call fn_par1
    call fn_fire
    xrl a,#FUJICMD_ACK
    jz host_ok
    jmp bad_host
host_ok:

; ---- SET_DEVICE_FULLPATH(dev, host, mode, path) ----
    mov r2,#3
    mov r3,#1                   ; txlen = $0100 = 256
    mov a,#FUJICMD_SET_DEVICE_FULLPATH
    call fn_begin
    mov a,#DEVSLOT
    call fn_par1
    mov a,#HOSTSLOT
    call fn_par1
    mov a,#MODE_READ
    call fn_par1
    call push_path
    call fn_fire
    xrl a,#FUJICMD_ACK
    jz path_ok
    jmp bad_path
path_ok:

; ---- MOUNT_IMAGE(dev, mode), committed by hand ----
    mov r2,#2
    mov r3,#0
    mov a,#FUJICMD_MOUNT_IMAGE
    call fn_begin
    mov a,#DEVSLOT
    call fn_par1
    mov a,#MODE_READ
    call fn_par1
    mov a,#FN_R_ACKSEQ&0FFh     ; SEQ = ACKSEQ + 1, never 0
    call fn_read
    inc a
    jnz m_seq
    inc a
m_seq:
    mov r0,#V_SEQ
    mov @r0,a
    mov r0,#FN_W_SEQ
    movx @r0,a                  ; launches it; the push begins

poll:
    mov a,#FN_R_ACKSEQ&0FFh
    call fn_read
    mov r0,#V_SEQ
    xrl a,@r0
    jz acked
    call draw_prog
    jmp poll

acked:
    mov a,#FN_R_REPLY_CMD&0FFh
    call fn_read
    xrl a,#FUJICMD_ACK
    jz reply_ok
    jmp bad_mount
reply_ok:
    call draw_prog              ; the final state, drawn once more
    mov a,#FN_R_BOOT_STATE&0FFh
    call fn_read
    xrl a,#FN_BOOT_READY
    jz ready
    jmp bad_state
ready:
    mov r3,#4                   ; hold the READY screen for about a second
hold_o:
    mov r2,#0
hold_m:
    mov r1,#0
hold_i:
    djnz r1,hold_i
    djnz r2,hold_m
    djnz r3,hold_o
    dis i
    dis tcnti
    stop tcnt
    jmp 0                       ; the console's soft reset

bad_nc:
    mov a,#msg_nc&0FFh
    jmp report
bad_host:
    mov a,#msg_host&0FFh
    jmp report
bad_path:
    mov a,#msg_path&0FFh
    jmp report
bad_mount:
    mov a,#msg_mount&0FFh
    jmp report
bad_state:
    mov a,#msg_state&0FFh

report:
    mov r4,a
    mov a,#P1_SEL_VDC
    outl p1,a
    mov r0,#vdc_char0
    mov r3,#XPOS
    mov a,r4
    call puts_e
    mov r0,#vdc_control
    mov a,#vdc_ctrl_fore
    movx @r0,a
spin:
    jmp spin

; draw_prog: S, a space and the three digits of the percent, on the single
; characters, redrawn only when one of them changed: MAME will not take object
; register writes while the foreground is on, so the foreground goes off for
; the drawing, and a redraw per poll would leave the screen mostly blank.
; fn_read needs no P1 setting, so the polling loop above pays only for the reads.
    org 700h
draw_prog:
    mov a,#FN_R_BOOT_PCT&0FFh
    call fn_read
    mov r2,a                    ; the percent, raw
    mov a,#FN_R_BOOT_STATE&0FFh
    call fn_read
    mov r7,a                    ; the state, raw
    mov r0,#V_LAST
    mov a,@r0
    xrl a,r2
    jnz dp_draw
    inc r0
    mov a,@r0
    xrl a,r7
    jz dp_ret                   ; neither moved
dp_draw:
    mov r0,#V_LAST
    mov a,r2
    mov @r0,a
    inc r0
    mov a,r7
    mov @r0,a
    mov a,r7
    add a,#'0'
    mov r7,a
    mov r1,#' '                 ; the hundreds digit
    mov a,r2
    add a,#9Ch                  ; minus 100: carry says 100 or more
    jnc dp_two
    mov r1,#'1'
    jmp dp_to
dp_two:
    add a,#100                  ; give it back
dp_to:
    call to_dec                 ; r5 = tens, r6 = units
    mov a,#P1_SEL_VDC
    outl p1,a
    mov r0,#vdc_control
    clr a
    movx @r0,a                  ; foreground off while the registers change
    mov r0,#vdc_char0
    mov r3,#XPOS
    mov a,r7
    call show_char
    mov a,#' '
    call show_char
    mov a,r1
    call show_char
    mov a,r5
    call show_char
    mov a,r6
    call show_char
    mov r0,#vdc_control
    mov a,#vdc_ctrl_fore
    movx @r0,a
dp_ret:
    ret

    org 0D02h
msg_nc:    db "NO CART",0
msg_host:  db "HOST FAIL",0
msg_path:  db "PATH FAIL",0
msg_mount: db "MOUNT FAIL",0
msg_state: db "NOT READY",0

    include "bootpath.inc"      ; bootpath, generated by build.sh

    include "fujistub.inc"

    if PAGE=0
    org O2_APP_HDR              ; covered by the mailbox at run time
    db "APPB",O2_APP_VERSION,NPAGES
    endif
