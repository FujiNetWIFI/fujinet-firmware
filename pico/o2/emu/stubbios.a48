; stubbios.a48 -- minimal stand-in for the O2's 1K internal BIOS, so the
; emulator needs no copyrighted dump. It only jumps to $400; carts run against
; it must not call the BIOS and must drive the VDC themselves.

    cpu 8048
    org 0

reset:
    jmp 400h        ; the real BIOS lands here on power-up/reset

    org 3           ; external interrupt vector
    retr

    org 7           ; timer interrupt vector
    retr

    org 3FFh        ; pad the image out to a full 1K
    db 0
