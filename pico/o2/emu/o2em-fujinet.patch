diff --git a/fujinet.c b/fujinet.c
new file mode 100644
index 0000000..4095752
--- /dev/null
+++ b/fujinet.c
@@ -0,0 +1,350 @@
+/* fujinet.c -- o2em model of the FujiNet RP2040 cartridge.
+ *
+ * Stands in for the cartridge so the 8048 client can be developed and
+ * regression-tested with no hardware.
+ *
+ * It is NOT a reimplementation. The mailbox protocol -- register decode, the
+ * SEQ/ACKSEQ interlock, the DBC push receiver -- is fujimail.c, compiled
+ * straight out of the cartridge firmware, and fujibus.c and o2map.c likewise.
+ * What is left here is only the port: where a published byte goes (an emulator
+ * array rather than a live bus), how a frame reaches the ESP32-S3 (a TCP socket
+ * to fujinet-pc-rs232's BoIP listener rather than USB CDC), and what to do with
+ * a committed image.
+ *
+ * So every run of this model exercises the code the cartridge actually ships.
+ *
+ * Fidelity note: the socket round-trip here is synchronous, so the emulated
+ * console sees ACKSEQ already updated on its first poll. Real hardware makes it
+ * wait. The client code is identical either way -- it must poll regardless --
+ * but this model will not catch a client that forgets to.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
+#include <netdb.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+
+#include "types.h"
+#include "vmachine.h"
+#include "fujinet.h"
+#include "fujibus.h"
+#include "fujimail.h"
+#include "fuji_mailbox.h"
+#include "o2map.h"
+
+#define FUJI_DEVICEID_DBC 0xFF
+
+#define RX_RAW_MAX 1088   /* must hold a SLIP-encoded 512-byte DBC push frame */
+
+static int fd = -1;
+static int dbg = 0;
+static const char *bootdump;
+static Byte pending[FUJIMAIL_STAGE_MAX];
+static unsigned pending_len;
+static int mailbox_active = 1;
+
+extern Byte rom_table[8][4096];
+
+int fujinet_active(void) { return fd >= 0; }
+
+void fujinet_set_bootdump(const char *prefix) { bootdump = prefix; }
+
+/* ---- the cart owns $F20-$FFF of the program window, in every bank ---- */
+
+static void poke(unsigned addr, Byte v)
+{
+    int b;
+    if (!mailbox_active)
+        return;   /* a booted game owns this page now */
+    for (b = 0; b < 8; b++)
+        rom_table[b][addr & 0xFFF] = v;
+}
+
+/* main.c paints unconditionally, including when no -fujinet was given, so the
+ * port has to be live before the socket is. */
+static void ensure_port(void);
+
+void fujinet_paint(void)
+{
+    ensure_port();
+    fujimail_paint();
+}
+
+/* ---- transport ---- */
+
+int fujinet_init(const char *hostport, int debug)
+{
+    ensure_port();
+    char host[256], *colon;
+    int port = 9995, one = 1;
+    struct addrinfo hints, *res = NULL;
+    char portstr[16];
+
+    dbg = debug;
+    snprintf(host, sizeof host, "%s", hostport ? hostport : "localhost:9995");
+    colon = strrchr(host, ':');
+    if (colon) { *colon = '\0'; port = atoi(colon + 1); }
+    if (host[0] == '\0') snprintf(host, sizeof host, "localhost");
+    snprintf(portstr, sizeof portstr, "%d", port);
+
+    memset(&hints, 0, sizeof hints);
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    if (getaddrinfo(host, portstr, &hints, &res) != 0 || res == NULL) {
+        fprintf(stderr, "fujinet: cannot resolve %s:%d\n", host, port);
+        return -1;
+    }
+    /* Walk every result: "localhost" usually resolves to ::1 first, while
+     * fujinet-pc's BoIP listener binds 127.0.0.1 only. */
+    {
+        struct addrinfo *ai;
+        for (ai = res; ai != NULL; ai = ai->ai_next) {
+            fd = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
+            if (fd < 0)
+                continue;
+            if (connect(fd, ai->ai_addr, ai->ai_addrlen) == 0)
+                break;
+            close(fd);
+            fd = -1;
+        }
+    }
+    if (fd < 0) {
+        fprintf(stderr, "fujinet: cannot connect to %s:%d (%s)\n",
+                host, port, strerror(errno));
+        freeaddrinfo(res);
+        return -1;
+    }
+    freeaddrinfo(res);
+    setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
+    fprintf(stderr, "fujinet: connected to %s:%d\n", host, port);
+    return 0;
+}
+
+void fujinet_close(void)
+{
+    if (fd >= 0) { close(fd); fd = -1; }
+}
+
+/* Read one complete SLIP frame (two 0xC0 delimiters) or time out. */
+static fb_status_t read_frame(Byte *buf, size_t cap, size_t *out_len, int secs)
+{
+    size_t n = 0;
+    int ends = 0;
+    struct timeval deadline, now;
+
+    gettimeofday(&deadline, NULL);
+    deadline.tv_sec += secs;
+
+    for (;;) {
+        fd_set rf;
+        struct timeval tv;
+        long remain;
+
+        gettimeofday(&now, NULL);
+        remain = (deadline.tv_sec - now.tv_sec) * 1000000L
+               + (deadline.tv_usec - now.tv_usec);
+        if (remain <= 0)
+            return FB_ETIMEOUT;
+        tv.tv_sec = remain / 1000000L;
+        tv.tv_usec = remain % 1000000L;
+
+        FD_ZERO(&rf); FD_SET(fd, &rf);
+        if (select(fd + 1, &rf, NULL, NULL, &tv) <= 0)
+            return FB_ETIMEOUT;
+
+        while (n < cap) {
+            unsigned char c;
+            ssize_t r = recv(fd, &c, 1, MSG_DONTWAIT);
+            if (r <= 0) break;
+            buf[n++] = c;
+            if (c == 0xC0 && ++ends == 2) { *out_len = n; return FB_OK; }
+        }
+        if (n >= cap)
+            return FB_ETOOBIG;
+    }
+}
+
+/* ---- the port ---- */
+
+static bool port_link_up(void)
+{
+    return fujinet_active();
+}
+
+static fb_status_t port_transact(uint8_t device, uint8_t command,
+                                 const fb_param_t *params, unsigned nparams,
+                                 const uint8_t *payload, uint16_t payload_len,
+                                 uint32_t timeout_ms, fb_reply_t *reply)
+{
+    static Byte req[FN_TX_MAX + 64];
+    static Byte raw[RX_RAW_MAX];
+    size_t reqlen, rawlen;
+    fb_status_t st;
+    int secs = (int)((timeout_ms + 999) / 1000);
+
+    if (!fujinet_active())
+        return FB_ENOLINK;
+
+    reqlen = fujibus_build_request(device, command, params, nparams,
+                                   payload, payload_len, req, sizeof req);
+    if (reqlen == 0)
+        return FB_ETOOBIG;
+    if (send(fd, req, reqlen, MSG_NOSIGNAL) != (ssize_t) reqlen)
+        return FB_ENOLINK;
+
+    for (;;) {
+        st = read_frame(raw, sizeof raw, &rawlen, secs);
+        if (st != FB_OK)
+            return st;
+        if (!fujibus_parse_reply(raw, rawlen, reply))
+            return FB_EBADFRAME;
+        /* Push frames arrive interleaved with the reply we are waiting for;
+         * consuming one proves the link is alive, so the deadline restarts
+         * rather than counting down. */
+        if (!fujimail_inbound(reply))
+            return FB_OK;
+    }
+}
+
+static void port_send_bare(uint8_t device, uint8_t command,
+                           const uint8_t *payload, uint16_t payload_len)
+{
+    Byte frame[64];
+    size_t n = fujibus_build_request(device, command, NULL, 0,
+                                     payload, payload_len, frame, sizeof frame);
+    if (n)
+        send(fd, frame, n, MSG_NOSIGNAL);
+}
+
+static void dump_stream(int stream, const Byte *data, unsigned len)
+{
+    char path[512];
+    FILE *f;
+
+    if (bootdump == NULL)
+        return;
+    snprintf(path, sizeof path, "%s%s", bootdump, stream ? ".cfg" : ".rom");
+    f = fopen(path, "wb");
+    if (f == NULL) {
+        fprintf(stderr, "fujinet: cannot write %s\n", path);
+        return;
+    }
+    fwrite(data, 1, len, f);
+    fclose(f);
+    fprintf(stderr, "fujinet: bootdump %s (%u bytes)\n", path, len);
+}
+
+static void port_stream_end(int stream, const uint8_t *data, unsigned len,
+                            bool aborted)
+{
+    if (aborted)
+        return;
+    dump_stream(stream, data, len);
+    if (stream != 0)
+        return;
+    /* Staged, not installed: the console is still executing the client out of
+     * this same window. The swap happens on the next reset, which is what the
+     * cartridge does on the console's next $400 fetch. */
+    memcpy(pending, data, len);
+    pending_len = len;
+}
+
+static void port_on_txn(const fujimail_txn_t *t)
+{
+    char txt[40];
+    unsigned k, m = 0;
+
+    if (!dbg)
+        return;
+    for (k = 0; k < t->rxlen && m < sizeof txt - 1; k++) {
+        Byte c = t->rx[k];
+        if (c == 0)
+            break;
+        txt[m++] = (c >= 0x20 && c < 0x7F) ? (char) c : '.';
+    }
+    txt[m] = '\0';
+    fprintf(stderr,
+            "fujinet: dev=%02X cmd=%02X nparam=%u txlen=%u seq=%u"
+            " -> err=%d reply=%02X rxlen=%u%s%s%s\n",
+            t->device, t->command, t->nparam, t->txlen, t->seq,
+            t->status, t->reply_cmd, t->rxlen,
+            m ? " \"" : "", txt, m ? "\"" : "");
+}
+
+static void port_on_dbc(fujimail_dbc_ev_t ev, int stream, uint32_t expect,
+                        unsigned got, bool aborted)
+{
+    if (!dbg)
+        return;
+    if (ev == FUJIMAIL_DBC_OPEN)
+        fprintf(stderr, "fujinet: DBC open stream=%d size=%u\n", stream, expect);
+    else
+        fprintf(stderr, "fujinet: DBC close stream=%d got=%u%s\n",
+                stream, got, aborted ? " ABORTED" : "");
+}
+
+static const fujimail_port_t emu_port = {
+    .poke         = poke,
+    .link_up      = port_link_up,
+    .transact     = port_transact,
+    .send_bare    = port_send_bare,
+    .stream_end   = port_stream_end,
+    .wait_link_ms = NULL,       /* the socket round trip is synchronous */
+    .bootsel      = NULL,       /* nothing to reboot into under emulation */
+    .on_txn       = port_on_txn,
+    .on_dbc       = port_on_dbc,
+};
+
+void fujinet_ext_write(Byte adr, Byte dat)
+{
+    /* Once a game has booted the mailbox is disabled for the session and the
+     * register file must go deaf: $E0-$E3 is inside the range The Voice
+     * decodes, so ordinary games do write there, and a stray write would
+     * otherwise fire a transaction with whatever command was left in the
+     * registers -- and publish its reply over the running game's code. */
+    if (!mailbox_active)
+        return;
+    fujimail_write(adr, dat);
+}
+
+/* Called when the console is reset: this is where a staged image takes over. */
+void fujinet_on_reset(void)
+{
+    o2map_plan_t plan;
+
+    if (pending_len == 0)
+        return;
+    if (o2map_plan(pending, pending_len, &plan) == O2MAP_OK) {
+        o2map_apply(pending, &plan, rom_table);
+        mailbox_active = plan.mailbox_ok;
+        /* The image has just been laid over the mailbox page, so a mailbox that
+         * survives the boot has to be published into it again before the 8048
+         * restarts and looks for the magic. */
+        if (mailbox_active)
+            fujimail_paint();
+        fprintf(stderr, "fujinet: booted %u bytes as %u x %uK bank(s);"
+                        " mailbox %s for this session\n",
+                pending_len, plan.nbanks, plan.bank_bytes / 1024,
+                plan.mailbox_ok ? "kept" : "disabled");
+    } else {
+        fprintf(stderr, "fujinet: %u bytes: %s\n", pending_len,
+                o2map_strerror(o2map_plan(pending, pending_len, &plan)));
+    }
+    pending_len = 0;
+}
+
+static void ensure_port(void)
+{
+    static int done;
+
+    if (!done) {
+        done = 1;
+        fujimail_init(&emu_port);
+    }
+}
diff --git a/fujinet.h b/fujinet.h
new file mode 100644
index 0000000..51922e3
--- /dev/null
+++ b/fujinet.h
@@ -0,0 +1,29 @@
+/* fujinet.h -- o2em model of the FujiNet RP2040 cartridge. */
+#ifndef FUJINET_H
+#define FUJINET_H
+
+#include "types.h"
+
+/* Connect to a fujinet-pc-rs232 BoIP listener, "host:port". Returns 0 on ok. */
+int fujinet_init(const char *hostport, int debug);
+void fujinet_close(void);
+
+/* True once fujinet_init has succeeded; ext_write only forwards if so. */
+int fujinet_active(void);
+
+/* Called from ext_write() for external-data-window writes in $E0-$E3. */
+void fujinet_ext_write(Byte adr, Byte dat);
+
+/* Paint the cart-owned reply page ($F20-$FFF) into every ROM bank. Called once
+ * after the cart image is loaded so the magic bytes are live from reset. */
+void fujinet_paint(void);
+
+/* Write each pushed stream to PREFIX.rom / PREFIX.cfg, to validate the ESP32
+ * media path byte-for-byte with no cartridge in the loop. */
+void fujinet_set_bootdump(const char *prefix);
+
+/* Install a staged cart image. Called when the console is reset -- the cart
+ * cannot reset the O2 itself, so a booted game takes over on the next $400. */
+void fujinet_on_reset(void);
+
+#endif /* FUJINET_H */
