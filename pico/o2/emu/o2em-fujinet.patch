diff --git a/vdc.c b/vdc.c
index 57d7a99..c39c54d 100644
--- a/vdc.c
+++ b/vdc.c
@@ -828,3 +828,90 @@ void help(void)
     return;
 }
 
+
+/* ------------------------------------------------------------------------
+ * FujiNet headless harness: dump the emulated framebuffer without needing
+ * anyone to look at the window. vscreen holds BMPW*BMPH palette indices and
+ * `colors` is the 6-bit Allegro palette, so neither the display driver nor
+ * the Allegro BITMAP is involved -- this works even when the window is
+ * offscreen or the run is scripted.
+ * ------------------------------------------------------------------------ */
+void dump_screen(const char *path, int astext)
+{
+    /* The visible picture sits inside the 340x250 working buffer at the same
+     * offset finish_display() blits from (vdc.c:401, `bitmap, 7, 2+y`). */
+    const int x0 = 7, y0 = 2, w = WNDW, h = WNDH;
+    int x, y;
+
+    if (vscreen == NULL)
+        return;
+
+    if (path != NULL) {
+        FILE *f = fopen(path, "wb");
+        if (f == NULL) {
+            fprintf(stderr, "dump_screen: cannot write %s\n", path);
+        } else {
+            fprintf(f, "P6\n%d %d\n255\n", w, h);
+            for (y = 0; y < h; y++) {
+                for (x = 0; x < w; x++) {
+                    Byte c = vscreen[(y + y0) * BMPW + (x + x0)];
+                    /* Allegro palettes are 6-bit per channel */
+                    fputc(colors[c].r << 2, f);
+                    fputc(colors[c].g << 2, f);
+                    fputc(colors[c].b << 2, f);
+                }
+            }
+            fclose(f);
+            fprintf(stderr, "dump_screen: wrote %s (%dx%d)\n", path, w, h);
+        }
+    }
+
+    if (astext) {
+        /* VDC register state, so a wrong picture can be traced to the registers
+         * that produced it rather than guessed at. */
+        int r;
+        printf("VDC ctrl=%02X status=%02X color=%02X\n",
+               VDCwrite[0xA0], VDCwrite[0xA1], VDCwrite[0xA3]);
+        for (r = 0; r < 4; r++)
+            printf("  spr%d: y=%02X x=%02X attr=%02X\n", r,
+                   VDCwrite[r*4], VDCwrite[r*4+1], VDCwrite[r*4+2]);
+        for (r = 0; r < 12; r++)
+            printf("  chr%-2d: y=%02X x=%02X ptr=%02X ctl=%02X\n", r,
+                   VDCwrite[0x10+r*4], VDCwrite[0x11+r*4],
+                   VDCwrite[0x12+r*4], VDCwrite[0x13+r*4]);
+        for (r = 0; r < 4; r++) {
+            int b = 0x40 + r * 0x10;
+            printf("  quad%d: y=%02X x=%02X  ptr %02X/%02X %02X/%02X %02X/%02X %02X/%02X\n",
+                   r, VDCwrite[b], VDCwrite[b+1],
+                   VDCwrite[b+2], VDCwrite[b+3], VDCwrite[b+6], VDCwrite[b+7],
+                   VDCwrite[b+10], VDCwrite[b+11], VDCwrite[b+14], VDCwrite[b+15]);
+        }
+    }
+
+    if (astext) {
+        /* Coarse luminance rendering, 2x8 source pixels per cell, so a 320x240
+         * frame lands in 160x30 characters -- readable in a terminal. */
+        static const char ramp[] = " .:-=+*#%@";
+        for (y = 0; y < h; y += 8) {
+            char line[WNDW / 2 + 1];
+            int cx = 0;
+            for (x = 0; x < w; x += 2, cx++) {
+                long lum = 0;
+                int sx, sy, n = 0;
+                for (sy = 0; sy < 8 && y + sy < h; sy++) {
+                    for (sx = 0; sx < 2 && x + sx < w; sx++) {
+                        Byte c = vscreen[(y + sy + y0) * BMPW + (x + sx + x0)];
+                        lum += colors[c].r + colors[c].g + colors[c].b;
+                        n++;
+                    }
+                }
+                lum = n ? (lum * 9) / (n * 189) : 0;   /* 3*63 = 189 -> 0..9 */
+                if (lum > 9) lum = 9;
+                line[cx] = ramp[lum];
+            }
+            line[cx] = '\0';
+            printf("|%s|\n", line);
+        }
+        fflush(stdout);
+    }
+}
