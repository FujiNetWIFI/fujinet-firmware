+/* Scripted controller input: -input=FRAME:CODE[,FRAME:CODE...] with CODE one of
+ * u/d/l/r/f. Drives the same dbstick overrides the built-in debugger uses, so a
+ * browse-and-boot sequence can be replayed with nobody at the keyboard. Each
+ * press is held for a few frames so client-side edge detection actually sees
+ * it, then released. */
+static void harness_input(int frame)
+{
+    static int parsed = 0, n = 0, hold_until = 0;
+    static int fr[64];
+    static Byte val[64];
+    static Byte hold_val = 0xFF;
+    int i;
+
+    if (!parsed) {
+        const char *p = app_data.input;
+        parsed = 1;
+        while (p != NULL && *p != '\0' && n < 64) {
+            const char *c = strchr(p, ':');
+            Byte v = 0xFF;
+            if (c == NULL)
+                break;
+            switch (c[1]) {
+            case 'u': v &= (Byte)~0x01; break;
+            case 'r': v &= (Byte)~0x02; break;
+            case 'd': v &= (Byte)~0x04; break;
+            case 'l': v &= (Byte)~0x08; break;
+            case 'f': v &= (Byte)~0x10; break;
+            default: break;
+            }
+            fr[n] = atoi(p);
+            val[n] = v;
+            n++;
+            p = strchr(c, ',');
+            if (p != NULL)
+                p++;
+        }
+    }
+
+    for (i = 0; i < n; i++) {
+        if (fr[i] == frame) {
+            hold_val = val[i];
+            hold_until = frame + 8;
+            fprintf(stderr, "input: frame %d -> stick %02X\n", frame, hold_val);
+        }
+    }
+    harness_stick = (frame < hold_until) ? hold_val : 0;
+}
