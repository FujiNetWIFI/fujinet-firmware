diff --git a/fujinet.c b/fujinet.c
new file mode 100644
index 0000000..85e879c
--- /dev/null
+++ b/fujinet.c
@@ -0,0 +1,479 @@
+/* fujinet.c -- o2em model of the FujiNet RP2040 cartridge.
+ *
+ * Stands in for the cart firmware so the 8048 client can be developed and
+ * regression-tested with no hardware: it decodes the console's MOVX writes into
+ * the mailbox register file, speaks FujiBus over a TCP socket to a real
+ * fujinet-pc-rs232 (its BoIP channel is a plain serial-over-TCP listener), and
+ * publishes the reply into the cartridge program window at $F20-$FFF.
+ *
+ * The codec is fujibus.c copied verbatim from the Intellivision cart firmware --
+ * it has no pico-sdk and no TinyUSB, precisely so both the cart and this model
+ * can share it and stay bit-identical by construction.
+ *
+ * Fidelity note: the socket round-trip here is synchronous, so the emulated
+ * console sees ACKSEQ already updated on its first poll. Real hardware makes it
+ * wait. The client code is identical either way -- it must poll regardless --
+ * but this model will not catch a client that forgets to.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
+#include <netdb.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+
+#include "types.h"
+#include "vmachine.h"
+#include "fujinet.h"
+#include "fujibus.h"
+#include "fuji_mailbox.h"
+
+#define FUJI_DEVICEID_DBC 0xFF
+
+#define RX_RAW_MAX 1088   /* must hold a SLIP-encoded 512-byte DBC push frame */
+#define RX_MAX     1024
+
+static int fd = -1;
+static int dbg = 0;
+
+/* mailbox write-side state */
+static Byte regsel;
+static Byte mb_device, mb_cmd, mb_nparam;
+static unsigned mb_txlen;
+static Byte txbuf[FN_TX_MAX];
+static unsigned txptr;
+static Byte lastseq;
+
+/* mailbox read-side state */
+static Byte rxbuf[RX_MAX];
+static unsigned rxlen;
+static Byte rxslice;
+
+/* DBC push state. MediaTypeROM::mount() streams the cart image to device $FF
+ * while our MOUNT_IMAGE is still outstanding, so these frames arrive
+ * unsolicited in the middle of a transaction and each needs its own ACK. */
+#define DBC_STREAM_ROM 0
+#define DBC_STREAM_CFG 1
+#define STAGE_MAX      (64 * 1024)
+
+static int dbc_stream = -1;
+static Byte stage[STAGE_MAX];
+static unsigned stage_len;
+static uint32_t stage_expect;
+static Byte pending[STAGE_MAX];      /* committed image, installed on reset */
+static unsigned pending_len;
+static int mailbox_active = 1;
+static const char *bootdump;
+
+extern Byte rom_table[8][4096];
+
+int fujinet_active(void) { return fd >= 0; }
+
+void fujinet_set_bootdump(const char *prefix) { bootdump = prefix; }
+
+/* ---- the cart owns $F20-$FFF of the program window, in every bank ---- */
+
+static void poke(unsigned addr, Byte v)
+{
+    int b;
+    if (!mailbox_active)
+        return;   /* a booted game owns this page now */
+    for (b = 0; b < 8; b++)
+        rom_table[b][addr & 0xFFF] = v;
+}
+
+static void publish_slice(void)
+{
+    unsigned base = (unsigned) rxslice * FN_R_SLICE_LEN;
+    unsigned i;
+    for (i = 0; i < FN_R_SLICE_LEN; i++)
+        poke(FN_R_DATA + i, (base + i < rxlen) ? rxbuf[base + i] : 0);
+}
+
+void fujinet_paint(void)
+{
+    unsigned a;
+    if (!mailbox_active)
+        return;   /* a booted game owns $F00-$FFF; painting would corrupt it */
+    for (a = FN_R_ACKSEQ; a <= 0xFFF; a++)
+        poke(a, 0);
+    poke(FN_R_MAGIC0, 'F');
+    poke(FN_R_MAGIC1, 'N');
+    poke(FN_R_PROTO_VER, 1);
+    poke(FN_R_STATUS, fujinet_active() ? FN_R_STATUS_LINK : 0);
+}
+
+/* ---- transport ---- */
+
+int fujinet_init(const char *hostport, int debug)
+{
+    char host[256], *colon;
+    int port = 9995, one = 1;
+    struct addrinfo hints, *res = NULL;
+    char portstr[16];
+
+    dbg = debug;
+    snprintf(host, sizeof host, "%s", hostport ? hostport : "localhost:9995");
+    colon = strrchr(host, ':');
+    if (colon) { *colon = '\0'; port = atoi(colon + 1); }
+    if (host[0] == '\0') snprintf(host, sizeof host, "localhost");
+    snprintf(portstr, sizeof portstr, "%d", port);
+
+    memset(&hints, 0, sizeof hints);
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    if (getaddrinfo(host, portstr, &hints, &res) != 0 || res == NULL) {
+        fprintf(stderr, "fujinet: cannot resolve %s:%d\n", host, port);
+        return -1;
+    }
+    /* Walk every result: "localhost" usually resolves to ::1 first, while
+     * fujinet-pc's BoIP listener binds 127.0.0.1 only. */
+    {
+        struct addrinfo *ai;
+        for (ai = res; ai != NULL; ai = ai->ai_next) {
+            fd = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
+            if (fd < 0)
+                continue;
+            if (connect(fd, ai->ai_addr, ai->ai_addrlen) == 0)
+                break;
+            close(fd);
+            fd = -1;
+        }
+    }
+    if (fd < 0) {
+        fprintf(stderr, "fujinet: cannot connect to %s:%d (%s)\n",
+                host, port, strerror(errno));
+        freeaddrinfo(res);
+        return -1;
+    }
+    freeaddrinfo(res);
+    setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
+    fprintf(stderr, "fujinet: connected to %s:%d\n", host, port);
+    return 0;
+}
+
+void fujinet_close(void)
+{
+    if (fd >= 0) { close(fd); fd = -1; }
+}
+
+/* Read one complete SLIP frame (two 0xC0 delimiters) or time out. */
+static fb_status_t read_frame(Byte *buf, size_t cap, size_t *out_len, int secs)
+{
+    size_t n = 0;
+    int ends = 0;
+    struct timeval deadline, now;
+
+    gettimeofday(&deadline, NULL);
+    deadline.tv_sec += secs;
+
+    for (;;) {
+        fd_set rf;
+        struct timeval tv;
+        long remain;
+
+        gettimeofday(&now, NULL);
+        remain = (deadline.tv_sec - now.tv_sec) * 1000000L
+               + (deadline.tv_usec - now.tv_usec);
+        if (remain <= 0)
+            return FB_ETIMEOUT;
+        tv.tv_sec = remain / 1000000L;
+        tv.tv_usec = remain % 1000000L;
+
+        FD_ZERO(&rf); FD_SET(fd, &rf);
+        if (select(fd + 1, &rf, NULL, NULL, &tv) <= 0)
+            return FB_ETIMEOUT;
+
+        while (n < cap) {
+            unsigned char c;
+            ssize_t r = recv(fd, &c, 1, MSG_DONTWAIT);
+            if (r <= 0) break;
+            buf[n++] = c;
+            if (c == 0xC0 && ++ends == 2) { *out_len = n; return FB_OK; }
+        }
+        if (n >= cap)
+            return FB_ETOOBIG;
+    }
+}
+
+/* ---- the DBC ROM push ---- */
+
+static void dbc_send(Byte cmd)
+{
+    Byte frame[16];
+    size_t n = fujibus_build_request(FUJI_DEVICEID_DBC, cmd, NULL, 0, NULL, 0,
+                                     frame, sizeof frame);
+    if (n)
+        send(fd, frame, n, MSG_NOSIGNAL);
+}
+
+static void dump_stream(const char *suffix)
+{
+    char path[512];
+    FILE *f;
+    if (bootdump == NULL)
+        return;
+    snprintf(path, sizeof path, "%s%s", bootdump, suffix);
+    f = fopen(path, "wb");
+    if (f == NULL) {
+        fprintf(stderr, "fujinet: cannot write %s\n", path);
+        return;
+    }
+    fwrite(stage, 1, stage_len, f);
+    fclose(f);
+    fprintf(stderr, "fujinet: bootdump %s (%u bytes)\n", path, stage_len);
+}
+
+/* Lay a raw cart image into the 8 ROM banks the way o2em's own load_cart does:
+ * every bank is 4K with the console's internal BIOS occupying the low 1K, so a
+ * cart's bytes start at offset 1024. A 2K bank leaves A10 unconnected, hence
+ * the $C00-$FFF mirror of $800-$BFF.
+ *
+ * Banks are stored in REVERSE file order -- load_cart() reads them with
+ * `for (i = nb-1; i >= 0; i--)`. That is not an o2em quirk: bank select is
+ * `rom_table[~p1 & 3]`, so P10/P11 high at reset selects bank 0, which has to
+ * be the boot bank, and the boot bank is the LAST chunk of the file. Getting
+ * this backwards boots a cart into the middle of its own data. */
+static void install_image(const Byte *img, unsigned len)
+{
+    unsigned nb, i, per;
+
+    if (len % 3072 == 0) {
+        per = 3072;
+        nb = len / 3072;
+    } else {
+        per = 2048;
+        nb = len / 2048;
+    }
+    if (nb == 0 || nb > 8) {
+        fprintf(stderr, "fujinet: %u bytes is not a cart image this model maps\n",
+                len);
+        return;
+    }
+    for (i = 0; i < 8; i++) {
+        unsigned b = (i < nb) ? i : nb - 1;
+        memcpy(&rom_table[i][1024], img + (nb - 1 - b) * per, per);
+        if (per == 2048)
+            memcpy(&rom_table[i][3072], &rom_table[i][2048], 1024);
+    }
+    /* The mailbox lives at $F20-$FFF of the program window, which a real game
+     * uses for its own code. Same call the Intellivision cart makes: keep the
+     * game, drop the mailbox for the session rather than refusing to boot. */
+    mailbox_active = 0;
+    fprintf(stderr, "fujinet: booted %u bytes as %u x %uK bank(s);"
+                    " mailbox disabled for this session\n", len, nb, per / 1024);
+}
+
+/* Returns true if the frame was a push frame and has been consumed. */
+static int dbc_handle(const fb_reply_t *req)
+{
+    if (req->device != FUJI_DEVICEID_DBC)
+        return 0;
+
+    if (req->command == CMD_NET_OPEN) {
+        unsigned stream = (req->data_len > 0) ? req->data[0] : 0;
+        stage_expect = 0;
+        if (req->data_len >= 5)
+            stage_expect = (uint32_t) req->data[1]
+                         | ((uint32_t) req->data[2] << 8)
+                         | ((uint32_t) req->data[3] << 16)
+                         | ((uint32_t) req->data[4] << 24);
+        dbc_stream = (stream == DBC_STREAM_CFG) ? DBC_STREAM_CFG : DBC_STREAM_ROM;
+        stage_len = 0;
+        if (dbg)
+            fprintf(stderr, "fujinet: DBC open stream=%u size=%u\n",
+                    stream, stage_expect);
+        dbc_send(CMD_FUJI_ACK);
+        return 1;
+    }
+
+    if (req->command == CMD_NET_WRITE) {
+        if (stage_len + req->data_len <= sizeof stage) {
+            memcpy(stage + stage_len, req->data, req->data_len);
+            stage_len += req->data_len;
+        }
+        if (stage_expect)
+            poke(FN_R_BOOT_PCT,
+                 (Byte)((stage_len * 100) / stage_expect));
+        dbc_send(CMD_FUJI_ACK);
+        return 1;
+    }
+
+    if (req->command == CMD_NET_CLOSE) {
+        /* Bare CLOSE commits; payload 0x01 is an abort, so partial data is
+         * never booted and older peers stay compatible. */
+        int aborted = (req->data_len > 0 && req->data[0] == 0x01);
+        int stream = dbc_stream;
+        dbc_stream = -1;
+
+        if (dbg)
+            fprintf(stderr, "fujinet: DBC close stream=%d got=%u%s\n",
+                    stream, stage_len, aborted ? " ABORTED" : "");
+
+        if (!aborted && stream == DBC_STREAM_CFG)
+            dump_stream(".cfg");
+
+        if (!aborted && stream == DBC_STREAM_ROM) {
+            dump_stream(".rom");
+            /* Staged, not installed: the console is still executing the client
+             * out of this same window. The swap happens on the next reset,
+             * which is what the RP2040 does on the next $400 fetch. */
+            memcpy(pending, stage, stage_len);
+            pending_len = stage_len;
+            poke(FN_R_BOOT_PCT, 100);
+            poke(FN_R_BOOT_STATE, 1);
+        } else if (aborted) {
+            poke(FN_R_BOOT_STATE, 0x80);
+        }
+        dbc_send(CMD_FUJI_ACK);
+        return 1;
+    }
+
+    return 0;
+}
+
+/* Called when the console is reset: this is where a staged image takes over. */
+void fujinet_on_reset(void)
+{
+    if (pending_len == 0)
+        return;
+    install_image(pending, pending_len);
+    pending_len = 0;
+}
+
+/* ---- the transaction ---- */
+
+static void run_transaction(Byte seq)
+{
+    Byte req[FN_TX_MAX + 64];
+    Byte raw[RX_RAW_MAX];
+    fb_param_t params[8];
+    unsigned nparam = mb_nparam > 8 ? 8 : mb_nparam;
+    unsigned i, p = 0;
+    size_t reqlen, rawlen = 0;
+    fb_reply_t reply;
+    fb_status_t st = FB_OK;
+
+    /* Unpack the FN_W_DATA stream: NPARAM x {size, value LE}, then payload. */
+    for (i = 0; i < nparam && p < txptr; i++) {
+        unsigned sz = txbuf[p++], k;
+        if (sz != 1 && sz != 2 && sz != 4) { st = FB_EBADFRAME; break; }
+        params[i].size = (uint8_t) sz;
+        params[i].value = 0;
+        for (k = 0; k < sz && p < txptr; k++)
+            params[i].value |= (uint32_t) txbuf[p++] << (8 * k);
+    }
+
+    if (st == FB_OK) {
+        if (!fujinet_active()) {
+            st = FB_ENOLINK;
+        } else {
+            reqlen = fujibus_build_request(mb_device, mb_cmd, params, nparam,
+                                           txbuf + p, (uint16_t)(txptr - p),
+                                           req, sizeof req);
+            if (reqlen == 0) {
+                st = FB_ETOOBIG;
+            } else if (send(fd, req, reqlen, MSG_NOSIGNAL) != (ssize_t) reqlen) {
+                st = FB_ENOLINK;
+            } else {
+                /* MOUNT_IMAGE can take a TNFS fetch plus a whole ROM push. */
+                int secs = (mb_cmd == CMD_FUJI_MOUNT_IMAGE) ? 60 : 5;
+                for (;;) {
+                    st = read_frame(raw, sizeof raw, &rawlen, secs);
+                    if (st != FB_OK)
+                        break;
+                    if (!fujibus_parse_reply(raw, rawlen, &reply)) {
+                        st = FB_EBADFRAME;
+                        break;
+                    }
+                    /* Push frames arrive interleaved with the reply we are
+                     * waiting for; consuming one proves the link is alive, so
+                     * the deadline restarts rather than counting down. */
+                    if (!dbc_handle(&reply))
+                        break;
+                }
+            }
+        }
+    }
+
+    rxlen = 0;
+    if (st == FB_OK) {
+        rxlen = reply.data_len > RX_MAX ? RX_MAX : reply.data_len;
+        memcpy(rxbuf, reply.data, rxlen);
+        poke(FN_R_REPLY_CMD, reply.command);
+    } else {
+        poke(FN_R_REPLY_CMD, 0);
+    }
+
+    poke(FN_R_ERR, (Byte) st);
+    poke(FN_R_RXLEN_LO, (Byte)(rxlen & 0xFF));
+    poke(FN_R_RXLEN_HI, (Byte)(rxlen >> 8));
+    poke(FN_R_STATUS, fujinet_active() ? FN_R_STATUS_LINK : 0);
+    rxslice = 0;
+    publish_slice();
+    poke(FN_R_ACKSEQ, seq);      /* published LAST -- this is the interlock */
+
+    if (dbg)
+        fprintf(stderr,
+                "fujinet: dev=%02X cmd=%02X nparam=%u txlen=%u seq=%u"
+                " -> err=%d reply=%02X rxlen=%u\n",
+                mb_device, mb_cmd, nparam, (unsigned)(txptr - p), seq,
+                (int) st, rom_table[0][FN_R_REPLY_CMD & 0xFFF], rxlen);
+}
+
+void fujinet_ext_write(Byte adr, Byte dat)
+{
+    /* Once a game has booted, the mailbox is disabled for the session and the
+     * register file must go deaf: $E0-$E3 is inside the range The Voice decodes,
+     * so ordinary games do write there, and a stray write would otherwise fire a
+     * transaction with whatever command was left in the registers -- and publish
+     * its reply over the running game's code. Same session flag the
+     * Intellivision cart keeps for the identical reason. */
+    if (!mailbox_active)
+        return;
+
+    switch (adr) {
+    case FN_W_REGSEL:
+        regsel = dat;
+        break;
+
+    case FN_W_REGDATA:
+        switch (regsel) {
+        case FN_REG_DEVICE:   mb_device = dat; break;
+        case FN_REG_CMD:      mb_cmd = dat; break;
+        case FN_REG_NPARAM:   mb_nparam = dat; break;
+        case FN_REG_TXLEN_LO: mb_txlen = (mb_txlen & 0xFF00) | dat; break;
+        case FN_REG_TXLEN_HI: mb_txlen = (mb_txlen & 0x00FF) | (dat << 8); break;
+        case FN_REG_DATA_RST: txptr = 0; break;
+        case FN_REG_RXSLICE:  rxslice = dat; publish_slice(); break;
+        case FN_REG_BOOTSEL:
+            if (dat == FN_BOOTSEL_MAGIC)
+                fprintf(stderr, "fujinet: BOOTSEL requested (no-op under o2em)\n");
+            break;
+        default: break;   /* code/data bank: no effect on a single-bank image */
+        }
+        break;
+
+    case FN_W_DATA:
+        if (txptr < sizeof txbuf)
+            txbuf[txptr++] = dat;
+        break;
+
+    case FN_W_SEQ:
+        /* Same interlock as the Intellivision: an unchanged sequence number is
+         * a no-op, so a timed-out client retry can never replay a command. */
+        if (dat != lastseq) {
+            lastseq = dat;
+            run_transaction(dat);
+        }
+        break;
+
+    default:
+        break;
+    }
+}
diff --git a/fujinet.h b/fujinet.h
new file mode 100644
index 0000000..51922e3
--- /dev/null
+++ b/fujinet.h
@@ -0,0 +1,29 @@
+/* fujinet.h -- o2em model of the FujiNet RP2040 cartridge. */
+#ifndef FUJINET_H
+#define FUJINET_H
+
+#include "types.h"
+
+/* Connect to a fujinet-pc-rs232 BoIP listener, "host:port". Returns 0 on ok. */
+int fujinet_init(const char *hostport, int debug);
+void fujinet_close(void);
+
+/* True once fujinet_init has succeeded; ext_write only forwards if so. */
+int fujinet_active(void);
+
+/* Called from ext_write() for external-data-window writes in $E0-$E3. */
+void fujinet_ext_write(Byte adr, Byte dat);
+
+/* Paint the cart-owned reply page ($F20-$FFF) into every ROM bank. Called once
+ * after the cart image is loaded so the magic bytes are live from reset. */
+void fujinet_paint(void);
+
+/* Write each pushed stream to PREFIX.rom / PREFIX.cfg, to validate the ESP32
+ * media path byte-for-byte with no cartridge in the loop. */
+void fujinet_set_bootdump(const char *prefix);
+
+/* Install a staged cart image. Called when the console is reset -- the cart
+ * cannot reset the O2 itself, so a booted game takes over on the next $400. */
+void fujinet_on_reset(void);
+
+#endif /* FUJINET_H */
